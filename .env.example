# ==============================================================================
# Environment Configuration - Distributed Priority Task Queue & Resilient Job Orchestrator
# Copy this file to .env for local overrides
# ==============================================================================

# API Gateway Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_orchestrator
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/job_orchestrator

# Redis Configuration (Priority Queue, In-flight, Heartbeats)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# C++ Worker Configuration
WORKER_THREADS=4
WORKER_POLL_INTERVAL_MS=100
WORKER_HEARTBEAT_INTERVAL_MS=2000

# Reaper / Crash Recovery Configuration
REAPER_CHECK_INTERVAL_MS=3000
WORKER_HEARTBEAT_TIMEOUT_MS=6000

# Retry & Backoff Configuration
MAX_RETRIES=3
BASE_RETRY_DELAY_MS=1000
